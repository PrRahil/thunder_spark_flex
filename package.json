{
  "name": "thunder-spark-flex",
  "version": "0.1.0",
  "private": true,
  "description": "AI-powered delivery block grabber — iPhone first, Android ready",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev:api": "npm run dev -w @thunder-spark/api",
    "dev:mobile": "npm run start -w @thunder-spark/mobile",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "typescript": "5.9.3"
  }
}
